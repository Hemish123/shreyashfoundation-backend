{
  "info": {
    "_postman_id": "shreyas-foundation-api-collection-v3",
    "name": "Shreyas Foundation APIs",
    "description": "Complete flow APIs: 1. Quiz with Fixed Vibhag (Shishu/Arun/Kesari/Kishore), 2. Payment Verification (Unlocks Live WhatsApp Message), 3. Form Eligibility & Pre-filled data check, 4. Full Admission Form Submission with 7 Documents & Signatures, 5. Get Stored Applications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Submit Quiz (Score >= 4, Pending Payment)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vibhag\": \"Shishu\",\n  \"parent_name\": \"Ramesh Patel\",\n  \"child_name\": \"Aarav Patel\",\n  \"whatsapp_number\": \"9876543210\",\n  \"email\": \"ramesh.patel@example.com\",\n  \"answers\": {\n    \"1\": \"B\",\n    \"2\": \"C\",\n    \"3\": \"A\",\n    \"4\": \"D\",\n    \"5\": \"B\",\n    \"6\": \"C\",\n    \"7\": \"A\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/submit-quiz/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "submit-quiz",
            ""
          ]
        },
        "description": "Step 1: User submits the quiz. Evaluates answers. If score >= 4, sets is_eligible=true and payment_status='PENDING'. Note: WhatsApp message is NOT sent yet until payment is verified."
      },
      "response": []
    },
    {
      "name": "2. Verify Payment (Received -> Sends WhatsApp Link)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"submission_id\": 1,\n  \"payment_status\": \"RECEIVED\",\n  \"transaction_id\": \"TXN-PAY-987654\",\n  \"frontend_base_url\": \"http://localhost:3000\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/verify-payment/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "verify-payment",
            ""
          ]
        },
        "description": "Step 2: When payment is RECEIVED, updates status to RECEIVED and triggers live Meta WhatsApp Cloud API message with the pre-filled form link. If FAILED/NOT RECEIVED, WhatsApp message is not sent."
      },
      "response": []
    },
    {
      "name": "3. Check Form Eligibility & Get Pre-filled Data",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/admission-form/check-eligibility/?submission_id=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "admission-form",
            "check-eligibility",
            ""
          ],
          "query": [
            {
              "key": "submission_id",
              "value": "1"
            }
          ]
        },
        "description": "Step 3: Frontend opens link from WhatsApp. Validates that score >= 4, payment_status == RECEIVED, and form has not been already submitted. Returns prefilled_data (Vibhag, Parent Name, Child Name, WhatsApp, Email) locked for normal users."
      },
      "response": []
    },
